rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /clients/{token} {
      allow read: if request.auth != null &&
        (request.auth.token.admin == true || resource.data.agent_uid == request.auth.uid);
      allow create, update: if request.auth != null &&
        (request.auth.token.admin == true || request.resource.data.agent_uid == request.auth.uid);
    }
  }
}
